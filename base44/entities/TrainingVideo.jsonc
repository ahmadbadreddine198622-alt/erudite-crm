{
  "name": "TrainingVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title shown on the card and in the slide player"
    },
    "url": {
      "type": "string",
      "description": "YouTube or Google Drive link (raw share URL \u2014 parsed into an embed automatically)"
    },
    "description": {
      "type": "string",
      "description": "Optional summary shown under the title in the player"
    },
    "category": {
      "type": "string",
      "description": "Optional grouping label (e.g. 'Week 1', 'Mindset', 'Closing'). Drives the filter chips."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual ordering \u2014 lower numbers appear first in the grid and slide deck"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive videos are hidden from the presentation but kept in the database"
    }
  },
  "required": [
    "title",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}