{
  "name": "LeadScoreSnapshot",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "FK to Lead"
    },
    "conversation_id": {
      "type": "string",
      "description": "FK to the WhatsAppConversation this score was computed from"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this snapshot row was written"
    },
    "overall_score": {
      "type": "number"
    },
    "engagement_score": {
      "type": "number"
    },
    "intent_score": {
      "type": "number"
    },
    "sentiment_score": {
      "type": "number"
    },
    "budget_alignment_score": {
      "type": "number"
    },
    "property_fit_score": {
      "type": "number"
    },
    "trend": {
      "type": "string"
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes about this lead score snapshot (max 1000 chars)",
      "maxLength": 1000
    }
  },
  "required": [
    "lead_id",
    "captured_at"
  ]
}