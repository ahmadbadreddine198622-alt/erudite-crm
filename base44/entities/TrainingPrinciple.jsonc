{
  "name": "TrainingPrinciple",
  "type": "object",
  "properties": {
    "week_number": {
      "type": "number",
      "minimum": 1,
      "maximum": 17,
      "description": "Week 1-17"
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "rank_title": {
      "type": "string",
      "description": "Rank bestowed upon completing this week"
    },
    "directive_text": {
      "type": "string",
      "description": "The single directive for this week \u2014 shown in the gold strip"
    },
    "essence": {
      "type": "string",
      "description": "Short essence summary"
    },
    "erudite_lesson": {
      "type": "string",
      "description": "Full lesson text with paragraph breaks"
    },
    "reading_assignment": {
      "type": "string"
    },
    "daily_drills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reflection_prompt": {
      "type": "string"
    },
    "quiz_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "week_number",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}