{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique key identifying this sync state entry"
    },
    "value": {
      "type": "string",
      "description": "Stored value (parse as number or JSON as needed)"
    },
    "sync_token": {
      "type": "string",
      "description": "Google Calendar sync token for incremental syncs"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful sync timestamp"
    },
    "events_synced_count": {
      "type": "number",
      "default": 0,
      "description": "Total events synced"
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes about this sync state (max 1000 chars)",
      "maxLength": 1000
    }
  },
  "required": [
    "key"
  ]
}