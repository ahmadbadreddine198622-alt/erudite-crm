{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name_en": {
      "type": "string",
      "default": "ERUDITE REAL ESTATE"
    },
    "company_name_ar": {
      "type": "string",
      "default": "\u0627\u0644\u0625\u0631\u0648\u062f\u0627\u064a\u062a \u0644\u0644\u0639\u0642\u0627\u0631\u0627\u062a"
    },
    "establishment": {
      "type": "string",
      "default": "Erudite Property (Erudite Real Estate)"
    },
    "address": {
      "type": "string",
      "default": "Shop R-10, Marquise Square Tower, Marasi Drive, Business Bay, Dubai, U.A.E."
    },
    "po_box": {
      "type": "string",
      "default": "121828"
    },
    "phone": {
      "type": "string",
      "default": "+971 58 180 6000"
    },
    "email": {
      "type": "string",
      "default": "info@erudite-estate.com"
    },
    "website": {
      "type": "string",
      "default": "www.eruditeproperty.com"
    },
    "orn": {
      "type": "string",
      "default": "29322"
    },
    "brn": {
      "type": "string",
      "default": "34625"
    },
    "ded_license": {
      "type": "string",
      "default": "1032973"
    },
    "trn": {
      "type": "string",
      "default": "104029757200003"
    },
    "logo_url": {
      "type": "string",
      "description": "Public URL of the company logo"
    },
    "signature_url": {
      "type": "string",
      "description": "Public URL of the signature image"
    },
    "stamp_url": {
      "type": "string",
      "description": "Public URL of the company stamp image"
    },
    "signature_banner_url": {
      "type": "string",
      "description": "Public URL of the full-width branded email signature banner. Fetched on-the-fly by sendIMessage and attached as base64 on first contact (not stored in entity due to size limits)."
    },
    "imessage_signature_text": {
      "type": "string",
      "description": "Plain-text signature appended to outgoing iMessages. Single source of truth for iMessage signatures. No HTML."
    },
    "telegram_signature_text": {
      "type": "string",
      "description": "Plain-text signature appended to outgoing Telegram messages. Falls back to imessage_signature_text when empty. No HTML."
    },
    "logo_base64": {
      "type": "string",
      "description": "Base64 data URL of company logo \u2014 embedded directly by PDF functions"
    },
    "signature_base64": {
      "type": "string",
      "description": "Base64 data URL of signature"
    },
    "stamp_base64": {
      "type": "string",
      "description": "Base64 data URL of stamp"
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes about this company settings configuration (max 1000 chars)",
      "maxLength": 1000
    },
    "brain_autonomy": {
      "type": "string",
      "enum": [
        "off",
        "propose",
        "act_scheduling"
      ],
      "default": "propose",
      "description": "BRAIN V4 P6: the autonomy dial. off = the brain only writes suggestions onto the Landlord record (V3 behavior). propose = the brain materializes its suggested tasks/follow-ups as origin='aurora' proposal rows awaiting human approve/dismiss on the Aurora-proposes strip. act_scheduling = the brain's SCHEDULING proposals are auto-approved (calendar/follow-up rows only). At EVERY level nothing is ever sent to a landlord without a human pressing Send."
    }
  },
  "required": []
}