{
  "name": "Contact",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Contact's full name"
    },
    "phone": {
      "type": "string",
      "description": "Primary phone number"
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "List of email addresses for this contact (primary + additional)"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp number if different from phone"
    },
    "source": {
      "type": "string",
      "default": "phone_import",
      "description": "Source of the contact (e.g., phone_import, manual)"
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes about this contact"
    }
  },
  "required": [
    "full_name",
    "phone"
  ]
}