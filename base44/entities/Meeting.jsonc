{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "landlord_id": {
      "type": "string",
      "description": "FK \u2192 Landlord"
    },
    "agent_email": {
      "type": "string",
      "format": "email",
      "description": "Agent hosting the meeting"
    },
    "title": {
      "type": "string",
      "description": "Meeting title"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the meeting is scheduled"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "cancelled"
      ],
      "default": "pending"
    },
    "created_from_ai": {
      "type": "boolean",
      "default": false,
      "description": "True if created from an AI suggestion"
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event ID if synced"
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the customer confirmation email has been sent"
    }
  },
  "required": [
    "landlord_id"
  ]
}