{
  "name": "PFCredential",
  "type": "object",
  "properties": {
    "api_key": {
      "type": "string",
      "description": "Production API Key"
    },
    "api_secret": {
      "type": "string",
      "description": "Production API Secret"
    },
    "sandbox_api_key": {
      "type": "string",
      "description": "Sandbox API Key"
    },
    "sandbox_api_secret": {
      "type": "string",
      "description": "Sandbox API Secret"
    },
    "active_environment": {
      "type": "string",
      "enum": [
        "production",
        "sandbox"
      ],
      "default": "sandbox",
      "description": "Which environment is currently active"
    },
    "is_connected": {
      "type": "boolean",
      "default": false,
      "description": "Production connection status"
    },
    "sandbox_is_connected": {
      "type": "boolean",
      "default": false,
      "description": "Sandbox connection status"
    },
    "last_tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "test_message": {
      "type": "string"
    },
    "access_token": {
      "type": "string",
      "description": "Production JWT \u2014 backend-only"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "sandbox_access_token": {
      "type": "string",
      "description": "Sandbox JWT \u2014 backend-only"
    },
    "sandbox_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scopes_granted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scopes from the active token"
    },
    "listings_sync_last_completed_page": {
      "type": "number",
      "default": 0
    },
    "listings_sync_total_pages": {
      "type": "number"
    },
    "listings_sync_in_progress_since": {
      "type": "string",
      "format": "date-time"
    },
    "listings_sync_last_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}