{
  "name": "LandlordAppointment",
  "type": "object",
  "properties": {
    "landlord_id": {
      "type": "string",
      "description": "FK to Landlord"
    },
    "agent_email": {
      "type": "string"
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30
    },
    "type": {
      "type": "string",
      "enum": [
        "call",
        "viewing",
        "meeting"
      ],
      "default": "call"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event ID if synced"
    },
    "channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "call",
        "email"
      ],
      "description": "Follow-up channel (separate from the call/viewing/meeting type)"
    },
    "created_from_ai": {
      "type": "boolean",
      "default": false,
      "description": "true when the follow-up was created from an AI suggestion chip"
    },
    "ai_source": {
      "type": "string",
      "description": "Which FollowupTemplate seeded the follow-up, e.g. silence_nudge_24h"
    },
    "was_edited_after_draft": {
      "type": "boolean",
      "default": false,
      "description": "true if the user changed the AI-drafted notes before saving"
    }
  },
  "required": [
    "landlord_id",
    "datetime",
    "type"
  ]
}