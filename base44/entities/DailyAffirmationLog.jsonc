{
  "name": "DailyAffirmationLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "affirmed": {
      "type": "boolean",
      "default": true
    },
    "method": {
      "type": "string",
      "default": "tap"
    },
    "affirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "log_date"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}