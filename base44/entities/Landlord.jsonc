{
  "name": "Landlord",
  "type": "object",
  "properties": {
    "lead_type": {
      "type": "string",
      "enum": [
        "landlord_sale",
        "landlord_rent",
        "landlord_both"
      ],
      "default": "landlord_both"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "full_name_en": {
      "type": "string"
    },
    "full_name_ar": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "E.164 format"
    },
    "whatsapp": {
      "type": "string"
    },
    "additional_phones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Secondary UAE mobile numbers beyond primary phone"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "additional_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "ar",
        "ru",
        "zh",
        "hi"
      ],
      "default": "en"
    },
    "nationality": {
      "type": "string"
    },
    "residence_country": {
      "type": "string"
    },
    "mailing_address": {
      "type": "string",
      "description": "Full one-line mailing address (e.g. 'Villa 34, Street 7, Springs 9, Dubai, United Arab Emirates'). Separate from residence_country; does not replace it."
    },
    "address_city": {
      "type": "string",
      "description": "City only from the mailing address (e.g. 'Dubai', 'London', 'Moscow')"
    },
    "address_postal_code": {
      "type": "string",
      "description": "Postal / ZIP code"
    },
    "address_country": {
      "type": "string",
      "description": "Country from the mailing address. Kept separate from residence_country."
    },
    "is_resident_uae": {
      "type": "boolean",
      "default": false
    },
    "landlord_archetype": {
      "type": "string",
      "enum": [
        "professional_investor",
        "individual_end_user_relocating",
        "distressed_seller",
        "inherited_owner",
        "developer_resale",
        "overseas_owner",
        "first_time_seller",
        "portfolio_optimizer",
        "accidental_landlord",
        "speculator_flipping"
      ],
      "default": "individual_end_user_relocating"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "phone",
        "email",
        "referral",
        "social_media",
        "dld_lookup",
        "concierge",
        "building_manager",
        "expired_listing",
        "fsbo_portal",
        "linkedin_outreach",
        "warm_intro",
        "other"
      ]
    },
    "referrer_landlord_id": {
      "type": "string"
    },
    "referrer_lead_id": {
      "type": "string"
    },
    "assigned_agent_email": {
      "type": "string",
      "format": "email"
    },
    "co_agent_email": {
      "type": "string",
      "format": "email"
    },
    "listing_manager_email": {
      "type": "string",
      "format": "email",
      "description": "Listing manager responsible for this unit's listing build workflow. Source of truth for listing manager queue."
    },
    "unit_reference": {
      "type": "string"
    },
    "unit_layout": {
      "type": "string",
      "description": "Unit layout shorthand (e.g. '2BHK', '3BHK', '4BHK', 'Penthouse', 'Studio')"
    },
    "handover_status": {
      "type": "string",
      "enum": [
        "Handed Over",
        "Not Handed Over",
        "Handover Booked"
      ],
      "default": "Not Handed Over",
      "description": "Keys handed over to buyer. When 'Handed Over', a green badge is shown on the landlord card. 'Handover Booked' shows a gold badge with the appointment date."
    },
    "handover_appointment_at": {
      "type": "string",
      "format": "date-time",
      "description": "Developer handover appointment slot, from developer intel"
    },
    "project_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "asking_price_aed": {
      "type": "number"
    },
    "stage": {
      "type": "string",
      "enum": [
        "initial_contact",
        "attempted_to_contact",
        "price_discovery",
        "listing_commitment",
        "form_a_initiation",
        "form_a_signing",
        "owner_documents",
        "photos_videos",
        "photographer_scheduling",
        "listing_creation",
        "internal_verification",
        "listing_publication",
        "final_confirmation",
        "marketing_agents",
        "marketing_network",
        "open_house",
        "client_blast",
        "deal_closed"
      ],
      "default": "initial_contact"
    },
    "sub_stage": {
      "type": "string"
    },
    "stage_entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "days_in_stage": {
      "type": "number"
    },
    "mandate_type": {
      "type": "string",
      "enum": [
        "exclusive",
        "non_exclusive",
        "off_market",
        "open_listing",
        "pocket"
      ]
    },
    "mandate_status": {
      "type": "string",
      "enum": [
        "none",
        "verbal",
        "form_a_drafted",
        "form_a_signed",
        "expired",
        "cancelled"
      ],
      "default": "none"
    },
    "mandate_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "mandate_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "commission_pct_negotiated": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "asking_price_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "change_reason": {
            "type": "string"
          }
        }
      }
    },
    "reserve_price": {
      "type": "number"
    },
    "days_on_market": {
      "type": "number"
    },
    "prior_brokerage_count": {
      "type": "number",
      "default": 0
    },
    "is_currently_listed_with_others": {
      "type": "boolean",
      "default": false
    },
    "competing_brokers_count": {
      "type": "number",
      "default": 0
    },
    "trust_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "trust_score_rationale": {
      "type": "string",
      "description": "One-line AI rationale for the trust score"
    },
    "responsiveness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "responsiveness_score_rationale": {
      "type": "string",
      "description": "Computed from average reply time and reply rate"
    },
    "mandate_win_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mandate_win_rationale": {
      "type": "string",
      "description": "One-line AI rationale for mandate win probability"
    },
    "estimated_commission_aed": {
      "type": "number"
    },
    "urgency_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "urgency_score_rationale": {
      "type": "string",
      "description": "One-line AI rationale for the urgency score"
    },
    "portfolio_scan_result": {
      "type": "object",
      "description": "Cached result from scanPortfolio \u2014 persisted to avoid re-scanning on every visit"
    },
    "portfolio_scanned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the portfolio scan was last run"
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "double_brokering",
          "title_dispute",
          "mortgage_arrears",
          "tenant_dispute",
          "unrealistic_pricing",
          "ghost_pattern",
          "shopping_brokers"
        ]
      }
    },
    "buying_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rapport_level": {
      "type": "string",
      "enum": [
        "cold",
        "warming",
        "rapport_built",
        "trust_established",
        "champion"
      ],
      "default": "cold"
    },
    "notes_internal": {
      "type": "string"
    },
    "ai_rolling_summary": {
      "type": "string"
    },
    "ai_deal_thesis": {
      "type": "string",
      "description": "V3 Phase 2 (REMEMBER): the persistent strategic narrative for winning this mandate \u2014 the durable 'where this deal is going and how we win it' plan that EVOLVES across orchestrator runs (distinct from ai_rolling_summary, which is the tactical current-state). Written by landlordOrchestrator (full tier); prior value is fed back in so it accrues rather than resets."
    },
    "ai_open_questions": {
      "type": "array",
      "description": "V3 Phase 2 (REMEMBER): ask-the-agent \u2014 specific uncertainties the brain wants a human to resolve (0-3). Only populated when the model is genuinely unsure about something a human can answer. Surfaced in the AI Intelligence card as 'Needs your input'.",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "ai_next_best_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "urgent"
          ]
        },
        "reasoning": {
          "type": "string"
        }
      }
    },
    "ai_coaching_for_agent": {
      "type": "string"
    },
    "ai_suggested_tasks": {
      "type": "array",
      "description": "AI-ranked shortlist of suggested next tasks (3-5), most-important first. Written by landlordOrchestrator; each item references a TaskTemplate by template_key.",
      "items": {
        "type": "object",
        "properties": {
          "template_key": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ai_suggested_followups": {
      "type": "array",
      "description": "AI-suggested time-based follow-ups (2-4). Written by landlordOrchestrator; each item references a FollowupTemplate by template_key.",
      "items": {
        "type": "object",
        "properties": {
          "template_key": {
            "type": "string"
          },
          "when_offset_days": {
            "type": "number"
          },
          "suggested_hour": {
            "type": "number"
          },
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "call",
              "email"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ai_objections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_competitive_intel": {
      "type": "string"
    },
    "ai_processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_strike_now": {
      "type": "boolean"
    },
    "ai_momentum": {
      "type": "string"
    },
    "ai_call_script": {
      "type": "object",
      "description": "The forged call script generated by generateLandlordCallScript from the orchestrator's analysis + the owner's full portfolio. Structured: opener, rapport, discovery_questions[], value_hooks[], objection_handlers[], portfolio_probe, the_ask, close, cheat_sheet[], opener_native, language, forged_at, model."
    },
    "ai_call_script_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the AI call script was last forged by generateLandlordCallScript."
    },
    "ai_approach_drafts": {
      "type": "object",
      "description": "The Approach Forge output \u2014 one ready-to-send draft script per telecommunication channel (email {subject, body_native, body_english_gloss}, whatsapp, telegram, sms, imessage {body_native, body_english_gloss}), plus mode ('approach' when no communication exists, 'followup' when history exists, auto-detected), situation (first_contact | owner_replied_last | awaiting_first_reply | active_thread_pending | after_call), language, angle_used, opening_line_history[], forged_at, model. Written by forgeApproachDrafts; auto-forged when the landlord card is opened; loaded into each channel composer's draft section. In follow-up mode the drafts continue the live conversation (answer the owner's last message first; value-drop on silence) instead of opening cold. Drafts only \u2014 never auto-sent."
    },
    "ai_approach_drafts_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the multi-channel approach drafts were last forged by forgeApproachDrafts."
    },
    "passport_no": {
      "type": "string"
    },
    "emirates_id_file_url": {
      "type": "string",
      "description": "Stored Emirates ID file (PDF/image) URL"
    },
    "passport_file_url": {
      "type": "string",
      "description": "Stored passport file (PDF/image) URL"
    },
    "lease_agreement_status": {
      "type": "string",
      "enum": [
        "drafted",
        "sent_for_signature",
        "signed",
        "cancelled"
      ],
      "default": "drafted"
    },
    "lease_pdf_url": {
      "type": "string"
    },
    "form_a_contract_number": {
      "type": "string"
    },
    "form_a_pdf_url": {
      "type": "string"
    },
    "form_a_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contract_number": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "pdf_url": {
            "type": "string"
          },
          "mandate_type": {
            "type": "string"
          },
          "mandate_status": {
            "type": "string"
          },
          "mandate_start_date": {
            "type": "string",
            "format": "date-time"
          },
          "mandate_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "asking_price_aed": {
            "type": "number"
          },
          "drive_file_id": {
            "type": "string"
          }
        }
      }
    },
    "ai_model_used": {
      "type": "string"
    },
    "last_orchestrator_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed",
        "needs_retry"
      ]
    },
    "needs_human_review": {
      "type": "boolean",
      "default": false
    },
    "review_reason": {
      "type": "string"
    },
    "stage_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "entered_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_days": {
            "type": "number"
          }
        }
      }
    },
    "ai_suggested_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "imessage_status": {
      "type": "string",
      "enum": [
        "unknown",
        "available",
        "not_available",
        "error"
      ],
      "default": "unknown",
      "description": "Resolved iMessage capability for the primary handle (mirrors the best confirmed handle from imessage_handles)"
    },
    "imessage_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the iMessage availability check last ran"
    },
    "imessage_handles": {
      "type": "array",
      "description": "All candidate iMessage handles auto-derived from the landlord's contact data (phones + emails), each with its resolved availability. Written by resolveLandlordIMessage.",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "description": "Normalized handle \u2014 phone in E.164 or lowercased email"
          },
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "source_field": {
            "type": "string",
            "description": "Which Landlord field this handle came from (e.g. phone, whatsapp, additional_phones, email, additional_emails)"
          },
          "imessage_status": {
            "type": "string",
            "enum": [
              "available",
              "not_available",
              "unknown",
              "error"
            ],
            "default": "unknown"
          }
        }
      }
    },
    "imessage_handle": {
      "type": "string",
      "description": "The primary confirmed-available iMessage handle (phones prioritized over emails). Empty when no handle is iMessage-available. Default send target for iMessage."
    },
    "imessage_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When resolveLandlordIMessage last derived and checked all handles"
    },
    "imessage_banner_sent": {
      "type": "boolean",
      "default": false,
      "description": "True when the branded signature banner has been sent to this landlord via iMessage. Prevents duplicate banner attachments on subsequent messages."
    },
    "whatsapp_status": {
      "type": "string",
      "enum": [
        "unknown",
        "available",
        "not_available",
        "error"
      ],
      "default": "unknown",
      "description": "Resolved WhatsApp capability \u2014 available if any of the landlord's phone numbers is a valid WhatsApp account"
    },
    "whatsapp_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the WhatsApp number availability check last ran"
    },
    "whatsapp_handles": {
      "type": "array",
      "description": "All of the landlord's phone numbers checked against WhatsApp, each with its validity. Written by checkLandlordWhatsApp.",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "description": "Normalized phone in E.164"
          },
          "source_field": {
            "type": "string",
            "description": "Which Landlord field this number came from (phone, whatsapp, additional_phones)"
          },
          "is_valid_whatsapp": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "whatsapp_handle": {
      "type": "string",
      "description": "The primary confirmed-valid WhatsApp number (E.164). Prefers the primary phone when valid. Empty when no number is WhatsApp-valid. Default send target for WhatsApp."
    },
    "whatsapp_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When checkLandlordWhatsApp last checked all numbers"
    },
    "wa_profile_pic_url": {
      "type": "string",
      "description": "WhatsApp profile picture URL (Evolution CDN) synced for this landlord's primary phone. Powers the vCard PHOTO embed and the identity avatar. 'no_photo' when the number has no public WhatsApp photo."
    },
    "wa_profile_pic_fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the WhatsApp profile picture was last synced by syncPeninsulaProfilePics"
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram numeric chat_id \u2014 set after the landlord starts a chat with the bot. Default send target for Telegram. Empty when not connected."
    },
    "telegram_username": {
      "type": "string",
      "description": "Telegram @username of the landlord, if known (display/reference only \u2014 sending requires telegram_chat_id)"
    },
    "ai_confidence": {
      "type": "object",
      "description": "BRAIN V4 Pillar 7: the brain's confidence in its own scores, each 0-1 \u2014 {trust, urgency, win_prob, overall}. Low confidence + high stakes \u21d2 coaching says qualify before you pitch. Written by landlordOrchestrator (full tier); rendered as confidence bands on the AI Intelligence card.",
      "properties": {
        "trust": {
          "type": "number"
        },
        "urgency": {
          "type": "number"
        },
        "win_prob": {
          "type": "number"
        },
        "overall": {
          "type": "number"
        }
      }
    },
    "ai_highest_leverage_unknown": {
      "type": "string",
      "description": "BRAIN V4 Pillar 7: the ONE fact that would most change the brain's conclusion about this landlord \u2014 the highest-expected-information-value unknown. Written by landlordOrchestrator (full tier)."
    },
    "ai_reasoning_trace": {
      "type": "array",
      "description": "BRAIN V4 Pillar 9: the reasoning trace for the LAST full run only \u2014 each major output (NBA, win_prob, chosen angle, campaign touch #1) with the evidence it stands on. Grounds cite deed:<unit+date> | doctrine:<rule> | prior:<bucket> | note:<date> | message:<date> | qualification:<date> | portfolio | calibration | council:<voice>. A claim with no citable ground must be weakened or dropped (the fabrication firewall made visible). Rendered as expandable Why? rows under the AI card sections.",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "grounds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ai_working_memory": {
      "type": "object",
      "description": "BRAIN V4 Pillar 5: the brain's scratchpad (~2KB cap) \u2014 open hypotheses, pending confirmations, last-event digest, last_full_run_at. Revised cheaply by the delta tier on every wake-nudge; fully re-synthesized by the full tier.",
      "properties": {
        "open_hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending_confirmations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_event_digest": {
          "type": "string"
        },
        "last_full_run_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ai_campaign_plan": {
      "type": "object",
      "description": "BRAIN V4 Pillar 4: the 14-30 day multi-touch campaign plan \u2014 {objective, touches:[{day_offset, channel, angle, template_key, freeform_intent, hour, success_criteria}], exit_conditions[], generated_at}. Doctrine-cadence-native, quiet-hours-safe (hours clamped 09-21 Asia/Dubai in code), REPLANNED whenever an outcome invalidates it. The next-best-action is touch #1 of this plan. Rendered as a timeline strip in the AI Intelligence card. Suggestions only \u2014 never auto-sent.",
      "properties": {
        "objective": {
          "type": "string"
        },
        "touches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day_offset": {
                "type": "number"
              },
              "channel": {
                "type": "string"
              },
              "angle": {
                "type": "string"
              },
              "template_key": {
                "type": "string"
              },
              "freeform_intent": {
                "type": "string"
              },
              "hour": {
                "type": "number"
              },
              "success_criteria": {
                "type": "string"
              }
            }
          }
        },
        "exit_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ai_council": {
      "type": "object",
      "description": "BRAIN V4 Pillar 6: THE COUNCIL's latest verdict on this deal \u2014 {verdict, dissent[], convened_at}. Convened only on high-stakes runs (commission >100k, contested win probability, needs_human_review, or stuck >14d), max once per landlord per 48h. The deal thesis absorbs the verdict; material disagreements surface as dissent.",
      "properties": {
        "verdict": {
          "type": "string"
        },
        "dissent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "convened_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "full_name_en",
    "phone",
    "source",
    "stage",
    "assigned_agent_email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.assigned_agent_email": "{{user.email}}"
        },
        {
          "data.listing_manager_email": "{{user.email}}"
        },
        {
          "data.co_agent_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.assigned_agent_email": "{{user.email}}"
        },
        {
          "data.listing_manager_email": "{{user.email}}"
        },
        {
          "data.co_agent_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}