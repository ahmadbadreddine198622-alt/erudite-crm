{
  "name": "Landlord",
  "type": "object",
  "properties": {
    "lead_type": {
      "type": "string",
      "enum": [
        "landlord_sale",
        "landlord_rent",
        "landlord_both"
      ],
      "default": "landlord_both"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "full_name_en": {
      "type": "string"
    },
    "full_name_ar": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "E.164 format"
    },
    "whatsapp": {
      "type": "string"
    },
    "additional_phones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Secondary UAE mobile numbers beyond primary phone"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "additional_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "ar",
        "ru",
        "zh",
        "hi"
      ],
      "default": "en"
    },
    "nationality": {
      "type": "string"
    },
    "residence_country": {
      "type": "string"
    },
    "mailing_address": {
      "type": "string",
      "description": "Full one-line mailing address (e.g. 'Villa 34, Street 7, Springs 9, Dubai, United Arab Emirates'). Separate from residence_country; does not replace it."
    },
    "address_city": {
      "type": "string",
      "description": "City only from the mailing address (e.g. 'Dubai', 'London', 'Moscow')"
    },
    "address_postal_code": {
      "type": "string",
      "description": "Postal / ZIP code"
    },
    "address_country": {
      "type": "string",
      "description": "Country from the mailing address. Kept separate from residence_country."
    },
    "is_resident_uae": {
      "type": "boolean",
      "default": false
    },
    "landlord_archetype": {
      "type": "string",
      "enum": [
        "professional_investor",
        "individual_end_user_relocating",
        "distressed_seller",
        "inherited_owner",
        "developer_resale",
        "overseas_owner",
        "first_time_seller",
        "portfolio_optimizer",
        "accidental_landlord",
        "speculator_flipping"
      ],
      "default": "individual_end_user_relocating"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "phone",
        "email",
        "referral",
        "social_media",
        "dld_lookup",
        "concierge",
        "building_manager",
        "expired_listing",
        "fsbo_portal",
        "linkedin_outreach",
        "warm_intro",
        "other"
      ]
    },
    "referrer_landlord_id": {
      "type": "string"
    },
    "referrer_lead_id": {
      "type": "string"
    },
    "assigned_agent_email": {
      "type": "string",
      "format": "email"
    },
    "co_agent_email": {
      "type": "string",
      "format": "email"
    },
    "listing_manager_email": {
      "type": "string",
      "format": "email",
      "description": "Listing manager responsible for this unit's listing build workflow. Source of truth for listing manager queue."
    },
    "unit_reference": {
      "type": "string"
    },
    "unit_layout": {
      "type": "string",
      "description": "Unit layout shorthand (e.g. '2BHK', '3BHK', '4BHK', 'Penthouse', 'Studio')"
    },
    "handover_status": {
      "type": "string",
      "enum": [
        "Handed Over",
        "Not Handed Over"
      ],
      "default": "Not Handed Over",
      "description": "Keys handed over to buyer. When 'Handed Over', a green badge is shown on the landlord card."
    },
    "project_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "asking_price_aed": {
      "type": "number"
    },
    "stage": {
      "type": "string",
      "enum": [
        "initial_contact",
        "attempted_to_contact",
        "price_discovery",
        "listing_commitment",
        "form_a_initiation",
        "form_a_signing",
        "owner_documents",
        "photos_videos",
        "photographer_scheduling",
        "listing_creation",
        "internal_verification",
        "listing_publication",
        "final_confirmation",
        "marketing_agents",
        "marketing_network",
        "open_house",
        "client_blast",
        "deal_closed"
      ],
      "default": "initial_contact"
    },
    "sub_stage": {
      "type": "string"
    },
    "stage_entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "days_in_stage": {
      "type": "number"
    },
    "mandate_type": {
      "type": "string",
      "enum": [
        "exclusive",
        "non_exclusive",
        "off_market",
        "open_listing",
        "pocket"
      ]
    },
    "mandate_status": {
      "type": "string",
      "enum": [
        "none",
        "verbal",
        "form_a_drafted",
        "form_a_signed",
        "expired",
        "cancelled"
      ],
      "default": "none"
    },
    "mandate_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "mandate_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "commission_pct_negotiated": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "asking_price_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "change_reason": {
            "type": "string"
          }
        }
      }
    },
    "reserve_price": {
      "type": "number"
    },
    "days_on_market": {
      "type": "number"
    },
    "prior_brokerage_count": {
      "type": "number",
      "default": 0
    },
    "is_currently_listed_with_others": {
      "type": "boolean",
      "default": false
    },
    "competing_brokers_count": {
      "type": "number",
      "default": 0
    },
    "trust_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "trust_score_rationale": {
      "type": "string",
      "description": "One-line AI rationale for the trust score"
    },
    "responsiveness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "responsiveness_score_rationale": {
      "type": "string",
      "description": "Computed from average reply time and reply rate"
    },
    "mandate_win_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mandate_win_rationale": {
      "type": "string",
      "description": "One-line AI rationale for mandate win probability"
    },
    "estimated_commission_aed": {
      "type": "number"
    },
    "urgency_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "urgency_score_rationale": {
      "type": "string",
      "description": "One-line AI rationale for the urgency score"
    },
    "portfolio_scan_result": {
      "type": "object",
      "description": "Cached result from scanPortfolio \u2014 persisted to avoid re-scanning on every visit"
    },
    "portfolio_scanned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the portfolio scan was last run"
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "double_brokering",
          "title_dispute",
          "mortgage_arrears",
          "tenant_dispute",
          "unrealistic_pricing",
          "ghost_pattern",
          "shopping_brokers"
        ]
      }
    },
    "buying_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rapport_level": {
      "type": "string",
      "enum": [
        "cold",
        "warming",
        "rapport_built",
        "trust_established",
        "champion"
      ],
      "default": "cold"
    },
    "notes_internal": {
      "type": "string"
    },
    "ai_rolling_summary": {
      "type": "string"
    },
    "ai_deal_thesis": {
      "type": "string",
      "description": "V3 Phase 2 (REMEMBER): the persistent strategic narrative for winning this mandate \u2014 the durable 'where this deal is going and how we win it' plan that EVOLVES across orchestrator runs (distinct from ai_rolling_summary, which is the tactical current-state). Written by landlordOrchestrator (full tier); prior value is fed back in so it accrues rather than resets."
    },
    "ai_open_questions": {
      "type": "array",
      "description": "V3 Phase 2 (REMEMBER): ask-the-agent \u2014 specific uncertainties the brain wants a human to resolve (0-3). Only populated when the model is genuinely unsure about something a human can answer. Surfaced in the AI Intelligence card as 'Needs your input'.",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "ai_next_best_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "urgent"
          ]
        },
        "reasoning": {
          "type": "string"
        }
      }
    },
    "ai_coaching_for_agent": {
      "type": "string"
    },
    "ai_suggested_tasks": {
      "type": "array",
      "description": "AI-ranked shortlist of suggested next tasks (3-5), most-important first. Written by landlordOrchestrator; each item references a TaskTemplate by template_key.",
      "items": {
        "type": "object",
        "properties": {
          "template_key": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ai_suggested_followups": {
      "type": "array",
      "description": "AI-suggested time-based follow-ups (2-4). Written by landlordOrchestrator; each item references a FollowupTemplate by template_key.",
      "items": {
        "type": "object",
        "properties": {
          "template_key": {
            "type": "string"
          },
          "when_offset_days": {
            "type": "number"
          },
          "suggested_hour": {
            "type": "number"
          },
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "call",
              "email"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ai_objections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_competitive_intel": {
      "type": "string"
    },
    "ai_processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_strike_now": {
      "type": "boolean"
    },
    "ai_momentum": {
      "type": "string"
    },
    "passport_no": {
      "type": "string"
    },
    "emirates_id_file_url": {
      "type": "string",
      "description": "Stored Emirates ID file (PDF/image) URL"
    },
    "passport_file_url": {
      "type": "string",
      "description": "Stored passport file (PDF/image) URL"
    },
    "lease_agreement_status": {
      "type": "string",
      "enum": [
        "drafted",
        "sent_for_signature",
        "signed",
        "cancelled"
      ],
      "default": "drafted"
    },
    "lease_pdf_url": {
      "type": "string"
    },
    "form_a_contract_number": {
      "type": "string"
    },
    "form_a_pdf_url": {
      "type": "string"
    },
    "form_a_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contract_number": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "pdf_url": {
            "type": "string"
          },
          "mandate_type": {
            "type": "string"
          },
          "mandate_status": {
            "type": "string"
          },
          "mandate_start_date": {
            "type": "string",
            "format": "date-time"
          },
          "mandate_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "asking_price_aed": {
            "type": "number"
          },
          "drive_file_id": {
            "type": "string"
          }
        }
      }
    },
    "ai_model_used": {
      "type": "string"
    },
    "last_orchestrator_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed",
        "needs_retry"
      ]
    },
    "needs_human_review": {
      "type": "boolean",
      "default": false
    },
    "review_reason": {
      "type": "string"
    },
    "stage_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "entered_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_days": {
            "type": "number"
          }
        }
      }
    },
    "ai_suggested_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "imessage_status": {
      "type": "string",
      "enum": [
        "unknown",
        "available",
        "not_available",
        "error"
      ],
      "default": "unknown",
      "description": "Resolved iMessage capability for the primary handle (mirrors the best confirmed handle from imessage_handles)"
    },
    "imessage_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the iMessage availability check last ran"
    },
    "imessage_handles": {
      "type": "array",
      "description": "All candidate iMessage handles auto-derived from the landlord's contact data (phones + emails), each with its resolved availability. Written by resolveLandlordIMessage.",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "description": "Normalized handle \u2014 phone in E.164 or lowercased email"
          },
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "source_field": {
            "type": "string",
            "description": "Which Landlord field this handle came from (e.g. phone, whatsapp, additional_phones, email, additional_emails)"
          },
          "imessage_status": {
            "type": "string",
            "enum": [
              "available",
              "not_available",
              "unknown",
              "error"
            ],
            "default": "unknown"
          }
        }
      }
    },
    "imessage_handle": {
      "type": "string",
      "description": "The primary confirmed-available iMessage handle (phones prioritized over emails). Empty when no handle is iMessage-available. Default send target for iMessage."
    },
    "imessage_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When resolveLandlordIMessage last derived and checked all handles"
    },
    "imessage_banner_sent": {
      "type": "boolean",
      "default": false,
      "description": "True when the branded signature banner has been sent to this landlord via iMessage. Prevents duplicate banner attachments on subsequent messages."
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram numeric chat_id \u2014 set after the landlord starts a chat with the bot. Default send target for Telegram. Empty when not connected."
    },
    "telegram_username": {
      "type": "string",
      "description": "Telegram @username of the landlord, if known (display/reference only \u2014 sending requires telegram_chat_id)"
    }
  },
  "required": [
    "full_name_en",
    "phone",
    "source",
    "stage",
    "assigned_agent_email"
  ]
}