{
  "name": "ClosingDealScoreSnapshot",
  "type": "object",
  "properties": {
    "closing_deal_id": {
      "type": "string",
      "description": "FK to ClosingDeal"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this snapshot row was written (= the closingDealOrchestrator run time)"
    },
    "stage": {
      "type": "string"
    },
    "ai_risk_score": {
      "type": "number",
      "description": "0-100 closing risk at this run (0 = on track, 100 = critically blocked)"
    },
    "ai_predicted_close_date": {
      "type": "string",
      "description": "ISO date the deal is predicted to reach 'complete' at this run (null if too uncertain)"
    }
  },
  "required": ["closing_deal_id", "captured_at"]
}
