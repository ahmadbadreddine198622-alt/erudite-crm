{
  "name": "ClosingDealScoreSnapshot",
  "type": "object",
  "properties": {
    "closing_deal_id": {
      "type": "string",
      "description": "FK to ClosingDeal"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this snapshot row was written"
    },
    "stage": {
      "type": "string"
    },
    "ai_risk_score": {
      "type": "number",
      "description": "0-100 closing risk at this run (0 = on track, 100 = critically blocked)"
    },
    "ai_predicted_close_date": {
      "type": "string",
      "description": "ISO date the deal is predicted to reach complete at this run (null if too uncertain)"
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes about this closing deal score snapshot (max 1000 chars)",
      "maxLength": 1000
    }
  },
  "required": [
    "closing_deal_id",
    "captured_at"
  ]
}