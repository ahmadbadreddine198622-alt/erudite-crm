{
  "name": "PFListing",
  "type": "object",
  "properties": {
    "pf_listing_id": {
      "type": "string",
      "description": "Property Finder reference number (e.g. erudite-3366406) \u2014 used for display and search"
    },
    "pf_internal_id": {
      "type": "string",
      "description": "Property Finder internal ULID (e.g. 01JP8XB5...) \u2014 used for API calls (PATCH, publish, unpublish)"
    },
    "reference_number": {
      "type": "string",
      "description": "Agent/agency reference number"
    },
    "project_id": {
      "type": "string",
      "description": "FK to Project entity"
    },
    "landlord_property_id": {
      "type": "string",
      "description": "FK to LandlordProperty entity"
    },
    "title": {
      "type": "string",
      "description": "Listing title (English)"
    },
    "title_ar": {
      "type": "string",
      "description": "Listing title (Arabic)"
    },
    "description": {
      "type": "string",
      "description": "Full property description (English)"
    },
    "description_ar": {
      "type": "string",
      "description": "Full property description (Arabic)"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "apartment",
        "villa",
        "townhouse",
        "penthouse",
        "studio",
        "duplex",
        "land",
        "office",
        "retail",
        "warehouse",
        "hotel_apartment"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "residential",
        "commercial"
      ],
      "default": "residential"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "sale",
        "rent"
      ],
      "description": "Sale or rental"
    },
    "price": {
      "type": "number",
      "description": "Price in AED"
    },
    "price_per_sqft": {
      "type": "number"
    },
    "price_on_request": {
      "type": "boolean",
      "default": false,
      "description": "Price hidden, shown as 'on request'"
    },
    "downpayment": {
      "type": "number",
      "description": "Downpayment amount (for sale)"
    },
    "number_of_cheques": {
      "type": "number",
      "description": "Number of cheques for rent payment"
    },
    "rent_frequency": {
      "type": "string",
      "enum": [
        "yearly",
        "monthly",
        "weekly",
        "daily"
      ],
      "description": "Rent payment frequency (for rent listings)"
    },
    "area_sqft": {
      "type": "number",
      "description": "Built-up area (BUA) in sqft"
    },
    "plot_size_sqft": {
      "type": "number",
      "description": "Plot size in sqft (for villas/land)"
    },
    "bedrooms": {
      "type": "number",
      "description": "0 = Studio"
    },
    "bathrooms": {
      "type": "number"
    },
    "floor_number": {
      "type": "string",
      "description": "Floor number (as string, e.g. '9' or 'G')"
    },
    "number_of_floors": {
      "type": "number",
      "description": "Total floors in the building"
    },
    "parking_slots": {
      "type": "number",
      "description": "Number of parking slots"
    },
    "location": {
      "type": "string",
      "description": "Community/area name"
    },
    "community": {
      "type": "string",
      "description": "PF community field (sub-area)"
    },
    "city": {
      "type": "string",
      "default": "Dubai"
    },
    "uae_emirate": {
      "type": "string",
      "default": "dubai",
      "description": "UAE emirate slug"
    },
    "building_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "furnishing": {
      "type": "string",
      "enum": [
        "furnished",
        "semi_furnished",
        "unfurnished"
      ]
    },
    "completion_status": {
      "type": "string",
      "enum": [
        "ready",
        "off_plan"
      ]
    },
    "project_status": {
      "type": "string",
      "enum": [
        "completed",
        "completed_primary",
        "off_plan"
      ],
      "description": "PF projectStatus field \u2014 maps from DLD compliance"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "publishing",
        "active",
        "inactive",
        "under_offer",
        "sold",
        "rented",
        "draft",
        "expired"
      ],
      "default": "draft",
      "description": "CRM mirror of PF portal live status"
    },
    "permit_number": {
      "type": "string",
      "description": "RERA/Trakheesi permit number (listingAdvertisementNumber)"
    },
    "issuing_license_number": {
      "type": "string",
      "description": "Issuing client license number (BRN / DED)"
    },
    "developer": {
      "type": "string"
    },
    "agent_email": {
      "type": "string",
      "format": "email"
    },
    "agent_name": {
      "type": "string"
    },
    "agency_name": {
      "type": "string"
    },
    "pf_agent_id": {
      "type": "number",
      "description": "PF internal agent/assignedTo ID"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "leads_count": {
      "type": "number",
      "default": 0
    },
    "inquiries_count": {
      "type": "number",
      "default": 0
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "expired_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "error"
      ],
      "default": "synced"
    },
    "sync_error": {
      "type": "string"
    },
    "property_id": {
      "type": "string",
      "description": "FK to internal Property entity"
    },
    "pf_url": {
      "type": "string",
      "description": "Public URL on Property Finder portal \u2014 from portals.propertyfinder.url"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pf_location_id": {
      "type": "number",
      "description": "PF location ID (location.id from API)"
    }
  },
  "required": [
    "listing_type",
    "status"
  ]
}