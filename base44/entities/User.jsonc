{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "agent",
        "viewer"
      ],
      "default": "agent"
    },
    "custom_role_id": {
      "type": "string",
      "description": "Reference to Role entity for granular permissions"
    },
    "department": {
      "type": "string",
      "description": "Team department e.g. Sales, Leasing"
    },
    "phone": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "team_name": {
      "type": "string",
      "description": "The team this member belongs to e.g. Sales Team A"
    },
    "is_team_leader": {
      "type": "boolean",
      "default": false,
      "description": "Whether this member is the team leader"
    },
    "brn": {
      "type": "string",
      "description": "Agent's RERA BRN (Broker Registration Number) \u2014 required by Property Finder per listing"
    },
    "pf_public_profile_id": {
      "type": "string",
      "description": "Cached Property Finder public profile.id for this agent \u2014 looked up once, then cached on the User record"
    },
    "position": {
      "type": "string",
      "description": "Job title / position e.g. CEO, Senior Agent"
    },
    "profile_image": {
      "type": "string",
      "description": "Public URL of the user's profile picture"
    },
    "signature_url": {
      "type": "string",
      "description": "Public URL of the user's signature image \u2014 auto-appended to every email they send"
    }
  },
  "required": []
}