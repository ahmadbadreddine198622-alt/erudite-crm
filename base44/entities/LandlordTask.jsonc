{
  "name": "LandlordTask",
  "type": "object",
  "properties": {
    "landlord_id": {
      "type": "string",
      "description": "FK to Landlord"
    },
    "title": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "assignee_email": {
      "type": "string"
    },
    "done": {
      "type": "boolean",
      "default": false
    },
    "created_from_ai": {
      "type": "boolean",
      "default": false,
      "description": "true when the title was pre-filled from an AI source, even if later edited"
    },
    "ai_source": {
      "type": "string",
      "description": "Which AI field seeded the task, e.g. ai_next_best_action"
    },
    "was_edited_after_draft": {
      "type": "boolean",
      "default": false,
      "description": "true if the user changed the AI draft before saving"
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes about this landlord task (max 1000 chars)",
      "maxLength": 1000
    },
    "origin": {
      "type": "string",
      "enum": [
        "human",
        "aurora"
      ],
      "default": "human",
      "description": "BRAIN V4 P6 (ACT): who created this task. 'aurora' rows are brain proposals materialized by landlordOrchestrator; 'human' rows are user-created. Aurora NEVER sends anything \u2014 tasks are internal work items only."
    },
    "proposal_status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "dismissed"
      ],
      "description": "BRAIN V4 P6 (ACT): lifecycle of an origin='aurora' proposal. 'proposed' renders in the Aurora-proposes strip; approve/dismiss writes an OutcomeEvent (proposal_approved / proposal_dismissed) so the brain LEARNS which proposals earn trust. Dismissing also marks the row done so task queues stay clean. Absent on human rows."
    }
  },
  "required": [
    "landlord_id",
    "title"
  ]
}