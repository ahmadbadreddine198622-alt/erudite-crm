{
  "name": "LeadDirective",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "FK to Lead. BUYER BRAIN V1 (B4d): twin of LandlordDirective - SEPARATE BRAINS BY DESIGN, no shared entity with the landlord side."
    },
    "directive_text": {
      "type": "string",
      "description": "The directive or comment text"
    },
    "type": {
      "type": "string",
      "enum": [
        "founder_directive",
        "frank_comment"
      ],
      "default": "founder_directive",
      "description": "founder_directive = boss instruction to the agent; frank_comment = AI assistant observation/commentary"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved"
      ],
      "default": "active"
    },
    "created_by_email": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "acknowledged_by_email": {
      "type": "string"
    },
    "acknowledged_by_name": {
      "type": "string"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent_response": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "lead_id",
    "directive_text"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}