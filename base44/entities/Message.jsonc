{
  "name": "Message",
  "type": "object",
  "properties": {
    "created_from_ai": {
      "type": "boolean",
      "default": false,
      "description": "V3 Phase 0: true when the outgoing message text was pre-filled from an AI draft (even if edited before send)"
    },
    "ai_source": {
      "type": "string",
      "description": "Which AI feature produced the draft, e.g. landlordOrchestrator.ai_suggested_messages"
    },
    "ai_draft_text": {
      "type": "string",
      "description": "The original AI-proposed text, for edit-distance against the sent text"
    },
    "was_edited_after_draft": {
      "type": "boolean",
      "default": false,
      "description": "True if the sent text differs from ai_draft_text"
    },
    "ai_disposition": {
      "type": "string",
      "enum": [
        "accepted",
        "edited",
        "ignored"
      ],
      "description": "accepted = sent unchanged from draft; edited = changed before send; ignored = draft generated but not used (the ignored case is derived in aggregation, not set at send time)"
    },
    "landlord_id": {
      "type": "string",
      "description": "FK to Landlord entity (optional - null for unmatched numbers)"
    },
    "lead_id": {
      "type": "string",
      "description": "FK to Lead entity \u2014 set when no landlord matches but a lead's phone matches the sender"
    },
    "phone": {
      "type": "string",
      "description": "Digits-only normalized number, e.g. 971544661177 (no +, no @s.whatsapp.net)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "description": "incoming = landlord sent, outgoing = agent sent"
    },
    "text": {
      "type": "string",
      "description": "Message body text"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent/received"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "read",
        "received",
        "failed"
      ],
      "default": "sent",
      "description": "Message delivery status"
    },
    "wa_message_id": {
      "type": "string",
      "description": "WhatsApp message ID \u2014 used for deduplication"
    },
    "channel": {
      "type": "string",
      "enum": [
        "business",
        "personal"
      ],
      "default": "personal",
      "description": "Which WhatsApp channel: business (erudite / Meta Cloud / +971582806000) or personal (erudite_whatsapp / Baileys / +971581806000)"
    },
    "instance_name": {
      "type": "string",
      "description": "Raw Evolution instance name (e.g. 'erudite', 'erudite_whatsapp', 'malik', 'samy', 'dari'). Stored separately from channel which only records 'business' or 'personal'."
    },
    "agent_email": {
      "type": "string",
      "format": "email",
      "description": "Agent who owns this message \u2014 stamped from landlord.assigned_agent_email on incoming, from the sending user on outgoing. Used for RLS scoping."
    },
    "media_url": {
      "type": "string",
      "description": "Base44 storage URL for downloaded media"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "document",
        "sticker",
        "none"
      ],
      "default": "none",
      "description": "Type of media attachment"
    },
    "media_mime": {
      "type": "string",
      "description": "MIME type of the media"
    },
    "media_filename": {
      "type": "string",
      "description": "Original filename of the media"
    },
    "media_duration": {
      "type": "number",
      "description": "Duration in seconds (for audio/video)"
    },
    "media_status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "download_failed",
        "upload_failed"
      ],
      "default": "pending",
      "description": "Media download/upload status"
    },
    "media_retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of download retry attempts"
    },
    "media_error": {
      "type": "string",
      "description": "Error message if media download failed"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "True if message was deleted/revoked"
    },
    "message_type": {
      "type": "string",
      "description": "Evolution message type (conversation, imageMessage, audioMessage, etc.)"
    },
    "reply_to_wa_id": {
      "type": "string",
      "description": "WhatsApp message ID this message is replying to"
    },
    "location_json": {
      "type": "object",
      "description": "Location data {lat, lng, name}"
    },
    "contacts_json": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Contact cards array"
    },
    "reaction": {
      "type": "string",
      "description": "Reaction emoji"
    },
    "caption": {
      "type": "string",
      "description": "Caption for media messages"
    },
    "is_voice_note": {
      "type": "boolean",
      "default": false,
      "description": "True if audio is a PTT voice note"
    },
    "transcript": {
      "type": "string",
      "description": "Original-language transcript of voice message"
    },
    "transcript_lang": {
      "type": "string",
      "description": "Detected ISO language code (ar/en/ru/fr)"
    },
    "translated_text": {
      "type": "string",
      "description": "English translation (only when not English)"
    },
    "transcript_status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "failed"
      ],
      "default": "pending",
      "description": "Transcription status"
    },
    "transcript_retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of transcription retry attempts"
    },
    "transcript_error": {
      "type": "string",
      "description": "Last transcription error message"
    }
  },
  "required": [
    "phone",
    "direction",
    "text",
    "timestamp"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.agent_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.agent_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}