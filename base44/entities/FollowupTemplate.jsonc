{
  "name": "FollowupTemplate",
  "type": "object",
  "properties": {
    "template_key": {
      "type": "string",
      "description": "Stable machine key, e.g. silence_nudge_24h. Used by AI follow-up suggestions to reference this template. Never renamed once data references it."
    },
    "label": {
      "type": "string",
      "description": "Human name shown in the picker, e.g. 24h silence nudge"
    },
    "default_channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "call",
        "email"
      ],
      "default": "whatsapp",
      "description": "Default channel for this follow-up"
    },
    "default_offset_days": {
      "type": "number",
      "default": 1,
      "description": "Days from today for the default follow-up date (0 = today)"
    },
    "default_hour": {
      "type": "number",
      "default": 10,
      "description": "Default hour of day (0-23, Asia/Dubai) for the calendar event, e.g. 10 = 10am, 18 = 6pm"
    },
    "category": {
      "type": "string",
      "enum": [
        "post_contact",
        "silence",
        "documents",
        "pricing",
        "viewing",
        "nurture",
        "mandate"
      ],
      "description": "Grouping for the picker UI"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the picker"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive templates are hidden from the picker"
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes about this follow-up template (max 1000 chars)",
      "maxLength": 1000
    }
  },
  "required": [
    "template_key",
    "label",
    "default_channel",
    "category"
  ]
}